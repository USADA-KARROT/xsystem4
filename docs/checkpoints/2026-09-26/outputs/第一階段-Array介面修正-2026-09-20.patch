+		case AIN_ENUM: case AIN_ENUM2: case AIN_STRING: case AIN_REF_STRING:
+		case AIN_STRUCT: case AIN_REF_STRUCT: case AIN_WRAP:
+			return false;
+		default:
+			break;
+		}
+	}
+	if (cb->nr_args == 2 && cb->vars[1].type.data == AIN_VOID) {
