 void heap_set_page(int slot, struct page *page)
 {
+	if (getenv("XSYS4_STRING_AUDIT") && slot > 1 && (size_t)slot < heap_size
+	    && heap[slot].type != VM_PAGE) {
+		fprintf(stderr, "PAGE_WRITE_AUDIT slot=%d ref=%d seq=%u oldtype=%d newpage=%p ptype=%d idx=%d ip=%zx\n",
+			slot, heap[slot].ref, heap[slot].seq, heap[slot].type,
+			(void *)page, page ? page->type : -1, page ? page->index : -1, instr_ptr);
+		vm_stack_trace();
+		fflush(stderr);
+		exit(87);
+	}
 #ifdef DEBUG_HEAP
